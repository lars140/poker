{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src/**/*.ts", "../src/server/backend.ts", "../src/lib/domain.ts", "../src/lib/errors.ts", "../src/lib/scoring.ts", "../src/lib/stats.ts", "../src/lib/validation.ts"],
  "exclude": ["../src/**/*.test.ts"]
}
